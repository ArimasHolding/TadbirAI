{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "fawatir_backend/Dockerfile",
    "watchPatterns": [
      "fawatir_backend/**"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn fawatir_backend.wsgi:application --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/api/docs/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
